{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidecar.local/spec/events.schema.json",
  "title": "SIDECAR Event Envelope",
  "type": "object",
  "required": ["event_id", "type", "occurred_at_ms", "payload"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "audio.frame.v1",
        "transcript.partial.v1",
        "transcript.final.v1",
        "question.detected.v1",
        "answer.started.v1",
        "answer.delta.v1",
        "answer.completed.v1",
        "answer.failed.v1",
        "status.changed.v1"
      ]
    },
    "occurred_at_ms": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "audio.frame.v1" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sequence", "sample_rate_hz", "channels", "format", "duration_ms", "data_b64"],
            "properties": {
              "sequence": { "type": "integer", "minimum": 0 },
              "sample_rate_hz": { "type": "integer", "minimum": 8000 },
              "channels": { "const": 1 },
              "format": { "const": "pcm_s16le" },
              "duration_ms": { "type": "number", "exclusiveMinimum": 0 },
              "data_b64": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["transcript.partial.v1", "transcript.final.v1"] }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["segment_id", "start_ms", "end_ms", "text"],
            "properties": {
              "segment_id": { "type": "string", "minLength": 1 },
              "start_ms": { "type": "integer", "minimum": 0 },
              "end_ms": { "type": "integer", "minimum": 0 },
              "speaker_id": { "type": ["string", "null"] },
              "text": { "type": "string" },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "question.detected.v1" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["question_id", "text", "source_segment_ids", "question_confidence", "addressed_to_user_confidence"],
            "properties": {
              "question_id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "source_segment_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "question_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "addressed_to_user_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
